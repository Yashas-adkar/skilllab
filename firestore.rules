rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // User Profile Documents
    // Collection: /users/{userId}
    match /users/{userId} {
      // Allow user to read and update only their own profile
      allow read: if isOwner(userId);
      
      // Allow creation only if the authenticated user's UID matches the document ID
      // and required fields are validated
      allow create: if isOwner(userId) 
        && request.resource.data.userId == userId
        && request.resource.data.email == request.auth.token.email
        // Prevent storing passwords in Firestore
        && !('password' in request.resource.data)
        && !('confirmPassword' in request.resource.data);

      // Allow updates only by the owner without modifying immutable fields (userId, email, createdAt)
      allow update: if isOwner(userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.email == resource.data.email
        && !('password' in request.resource.data);

      // Disallow user profile deletion by standard users
      allow delete: if false;
    }

    // Interview Sessions Collection
    match /interview_sessions/{sessionId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Stage Results Collection
    match /stage_results/{resultId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    // Final Evaluations Collection
    match /evaluations/{evaluationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // Evaluations should only be written by trusted backend / admin
      allow create, update: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow delete: if false;
    }
  }
}
